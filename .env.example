# Orderly — environment template. Copy to .env.local and fill in real values.

# Public — safe in the browser bundle (RLS protects data)
VITE_SUPABASE_URL=https://YOUR-PROJECT.supabase.co
VITE_SUPABASE_ANON_KEY=sb_publishable_xxx

# Payments (later)
# VITE_RAZORPAY_KEY_ID=

# SECRET — server-side only, never prefix with VITE_
SUPABASE_SECRET_KEY=sb_secret_xxx
# RAZORPAY_KEY_SECRET=
# RAZORPAY_WEBHOOK_SECRET=
